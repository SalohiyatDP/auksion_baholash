# ============================================================
# YerAuksion — muhit o'zgaruvchilari (SQLite, server/kredentsial talab qilinmaydi)
# ============================================================

# SQLite baza fayli.
#  - Lokal ish uchun (quyidagi yetarli): prisma/ ga nisbatan -> loyiha/data/app.db
#  - Ishlab chiqarish (hosting)da TO'LIQ (absolyut) yo'l tavsiya etiladi, masalan:
#    DATABASE_URL="file:/var/www/USER/data/www/narx.namresort.uz/data/app.db"
DATABASE_URL="file:../data/app.db"

# JWT sessiya uchun maxfiy kalit (ishlab chiqarishda albatta o'zgartiring)
JWT_SECRET="change-me-to-a-long-random-secret-string-please"

# Yuklangan va generatsiya qilingan fayllar katalogi
STORAGE_DIR="./storage"

# Ilova manzili
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ISPmanager/panel bergan port (bo'lmasa 3000). Panel odatda avtomatik beradi.
# PORT=39876

# Boshlang'ich foydalanuvchilar (birinchi seed'da yaratiladi)
SEED_ADMIN_EMAIL="admin@yerauksion.uz"
SEED_ADMIN_PASSWORD="admin123"
SEED_OPERATOR_EMAIL="operator@yerauksion.uz"
SEED_OPERATOR_PASSWORD="operator123"
