# PostgreSQL ulanish satri
DATABASE_URL="postgresql://yerauksion:yerauksion@localhost:5432/yerauksion?schema=public"

# JWT sessiya uchun maxfiy kalit (ishlab chiqarishda albatta o'zgartiring)
JWT_SECRET="change-me-to-a-long-random-secret-string-please"

# Yuklangan fayllar saqlanadigan katalog
STORAGE_DIR="./storage"

# Ilova manzili
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps API kaliti (SHP/KMZ ni xaritada ko'rsatish va hujjatga static map joylash uchun)
# https://console.cloud.google.com -> Maps JavaScript API + Static Maps API yoqilishi kerak
GOOGLE_MAPS_API_KEY=""

# Boshlang'ich admin foydalanuvchi (seed uchun)
SEED_ADMIN_EMAIL="admin@yerauksion.uz"
SEED_ADMIN_PASSWORD="admin123"
SEED_OPERATOR_EMAIL="operator@yerauksion.uz"
SEED_OPERATOR_PASSWORD="operator123"
