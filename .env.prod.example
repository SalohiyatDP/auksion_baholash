# ============================================================
# Docker production (docker-compose.prod.yml) uchun muhit o'zgaruvchilari.
#   cp .env.prod.example .env   (va qiymatlarni to'ldiring)
# Baza — SQLite (konteyner ichидa /app/data/app.db), alohida DB serveri kerak emas.
# ============================================================

# JWT sessiya kaliti — uzun tasodifiy satr (masalan: openssl rand -hex 32)
JWT_SECRET=BU_YERGA_UZUN_TASODIFIY_KALIT_YOZING

# Boshlang'ich foydalanuvchilar (birinchi ishga tushirishda yaratiladi)
SEED_ADMIN_EMAIL=admin@namresort.uz
SEED_ADMIN_PASSWORD=BU_YERGA_ADMIN_PAROLI
SEED_OPERATOR_EMAIL=operator@namresort.uz
SEED_OPERATOR_PASSWORD=BU_YERGA_OPERATOR_PAROLI
